# Existing broker keys stay exactly as they are in your current .env.

# Actual LLM commentary (optional; rules fallback works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_COMMENTARY_ENABLED=1

# Independent fundamentals for US + Europe
FMP_API_KEY=

# Keep at 0 unless you also want FMP to supply news/earnings.
# Yahoo/yfinance is used for news/earnings by default to save FMP quota.
FMP_NEWS_ENABLED=0

# Required/recommended identifier for SEC EDGAR requests
SEC_USER_AGENT=METOXES2 personal portfolio analytics your-email@example.com
